fact_id: 771675389145b9f6
problem_id: n18a_ceva_concurrency_20260829t190022z
author: high6
predecessors: []
glossary_introduces:
  ABC: the given nondegenerate triangle with vertices A, B, and C
  D: the given point in the interior of side BC
  E: the given point in the interior of side CA
  F: the given point in the interior of side AB
  P: the common point of the cevians in the necessity direction and the constructed common point in the sufficiency direction
  X: an arbitrary point in the affine plane of triangle ABC
  d_B: the normalized barycentric coordinate of D at B
  d_C: the normalized barycentric coordinate of D at C
  e_A: the normalized barycentric coordinate of E at A
  e_C: the normalized barycentric coordinate of E at C
  f_A: the normalized barycentric coordinate of F at A
  f_B: the normalized barycentric coordinate of F at B
  p_A: the normalized barycentric coordinate of P at A
  p_B: the normalized barycentric coordinate of P at B
